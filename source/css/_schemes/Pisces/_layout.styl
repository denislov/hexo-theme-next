// Top navigation bar layout (this fork replaces the original two-column
// Pisces/Gemini layout: the left sidebar is gone, the header is a full-width
// sticky bar, and the content is centred below it).

header.header {
  background: var(--topbar-bg);
  border-bottom: 1px solid var(--topbar-border);
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
}

.main {
  display: block;
  margin: 0;
  width: 100%;
}

.main-inner {
  border-radius: $border-radius-inner;
  box-sizing: border-box;
  margin-left: auto;
  margin-right: auto;
  margin-top: 12px;
  max-width: 900px;
  width: 100%;

  +tablet-mobile() {
    border-radius: initial;
  }

  +mobile() {
    margin-top: 8px;
  }
}

.footer-inner {
  padding-left: 0;
  padding-right: 0;
  width: auto;
}
