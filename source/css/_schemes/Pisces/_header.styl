// Header bar: brand on the left, controls on the right. On wide screens the
// tab bar is pulled into the middle of the same row (see the grid below).

.column {
  width: 100%;
}

.site-brand-container {
  align-items: center;
  background: transparent;
  display: flex;
  justify-content: space-between;
  min-height: 62px;
  padding: 0 24px;
}

.site-meta {
  flex-grow: 0;
  padding: 0;
  text-align: left;

  +mobile() {
    text-align: left;
  }
}

.brand,
.brand:hover {
  color: var(--topbar-fg);
}

.site-title {
  font-size: 1.6em;
  font-weight: 600;
  line-height: 1.3;
}

.logo-line {
  display: none;
}

// The hamburger is no longer needed: the tab bar is always visible.
.site-nav-toggle {
  display: none;
}

// Phones: keep the bar a little more compact.
+mobile() {
  .site-brand-container {
    min-height: 58px;
    padding: 0 14px;
  }

  .site-title {
    font-size: 1.35em;
  }
}

// Search + theme toggle, always shown.
.site-nav-right {
  align-items: center;
  display: flex;
  flex-direction: row;
  gap: 10px;

  .toggle {
    color: var(--topbar-fg-dim);
    font-size: 1.2em;
    padding: 12px;
    width: auto;

    &:hover {
      color: var(--topbar-fg);
    }
  }
}

// Wide screens: brand | centred tabs | controls, on one row.
// `display: contents` flattens the brand row so the three elements become
// grid children of the header itself.
@media (min-width: 768px) {
  header.header {
    align-items: center;
    display: grid;
    grid-template-areas: 'brand tabs controls';
    grid-template-columns: 1fr auto 1fr;
    min-height: 70px;
    padding: 0 24px;
  }

  .site-brand-container {
    display: contents;
  }

  .site-meta {
    grid-area: brand;
    justify-self: start;
  }

  .site-nav {
    grid-area: tabs;
    justify-self: center;
  }

  .site-nav-right {
    grid-area: controls;
    justify-self: end;
  }
}
