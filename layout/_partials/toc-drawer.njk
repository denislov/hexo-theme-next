{# Floating table-of-contents button + slide-in drawer.
   Rendered as a direct child of `.main-inner` (see post.njk) so that PJAX
   swaps it and no animated ancestor turns `position: fixed` into a
   containing block. #}
{%- if page.toc.enable and page.toc and page.content %}
  {%- set tocContent = toc(page.content, {class: 'nav', list_number: page.toc.number, max_depth: page.toc.max_depth}) %}
  {%- if tocContent and tocContent.length > 1 %}
    <button type="button" class="toc-fab" aria-label="{{ __('sidebar.toc') }}" title="{{ __('sidebar.toc') }}">
      <i class="fa fa-list-ul"></i>
    </button>
    <div class="toc-dimmer"></div>
    <aside class="toc-drawer" aria-hidden="true">
      <div class="toc-drawer-header">
        <span class="toc-drawer-title">{{ __('sidebar.toc') }}</span>
        <button type="button" class="toc-drawer-close" aria-label="关闭">
          <i class="fa fa-times"></i>
        </button>
      </div>
      <div class="toc-drawer-body">
        <div class="post-toc">{{ tocContent }}</div>
      </div>
    </aside>
  {%- endif %}
{%- endif %}
